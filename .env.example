# Squad server settings. Copy to ".env" next to docker-compose.yml and edit.

# Port published on the host.
CC_PORT=8080

# Address your friends use to reach the server; it is written into invite links.
# Example: https://squad.example.com  (leave empty to use whatever address each request came in on)
CC_PUBLIC_URL=

# Key the device tokens are hashed with. Use a long random value, e.g.:  openssl rand -hex 32
# Left empty, the server generates one and keeps it in the data volume. Changing it signs every device out.
CC_AUTH_SECRET=

# Optional. When set, enables the diagnostics endpoint:
#   curl -H "Authorization: Bearer <token>" http://localhost:8080/api/v1/admin/stats
CC_ADMIN_TOKEN=

# Optional. When set, a new PC must enter this key to register (keeps strangers off a public server).
CC_REGISTRATION_KEY=

# Members per squad (4 = a Fortnite squad) and default lifetime of an invite, in hours.
CC_MAX_SQUAD_SIZE=4
CC_INVITE_TTL_HOURS=168

# Set to 1 only when the server sits behind a reverse proxy that sets X-Forwarded-* (TLS termination).
CC_TRUST_PROXY=0
