{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Chest Counter Squad",
  "mainBinaryName": "ChestCounterSquad",
  "version": "2.0.0",
  "identifier": "app.chestcounter.squad",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "resources": {
      "engine/": "engine/"
    },
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": { "installMode": "currentUser" }
    }
  }
}
